{
  "name": "my-app",
  "productName": "Genisys",
  "version": "1.3.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "prestart": "taskkill /F /T /IM electron.exe >nul 2>&1 & exit 0",
    "start": "electron-forge start",
    "start:debug": "set ELECTRON_ENABLE_LOGGING=1&& set ELECTRON_ENABLE_STACK_DUMPING=1&& electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "installer": "installer\\build-installer.bat",
    "release": "node tools/release.mjs",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "test": "node tools/run-tests.mjs"
  },
  "keywords": [],
  "author": {
    "name": "kevin-250",
    "email": "fastapp250@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "electron": "39.0.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "cobe": "^2.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "highlight.js": "^11.12.0"
  },
  "overrides": {
    "yauzl": "^3.2.0"
  }
}
