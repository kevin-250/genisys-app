{
  "name": "search_web",
  "description": "Search the web (Google by default) in the default or a named browser.",
  "triggers": [
    "search",
    "google",
    "look",
    "find",
    "youtube"
  ],
  "params": {
    "query": {
      "type": "string",
      "required": true
    },
    "browser": {
      "type": "enum",
      "values": [
        "chrome",
        "edge",
        "firefox",
        "brave",
        "opera"
      ],
      "required": false
    },
    "site": {
      "type": "enum",
      "values": [
        "youtube",
        "bing",
        "duckduckgo",
        "wikipedia",
        "github",
        "amazon"
      ],
      "required": false
    }
  },
  "destructive": false,
  "needs_ai": false,
  "paths": [],
  "native": "search_web"
}
